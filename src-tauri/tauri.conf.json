{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anvil",
  "version": "0.1.0",
  "identifier": "com.laraveltoolkit.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anvil",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNUY3RDkyODFFRTc5MUYKUldRZmVlNkJrbjFmb2hlUVdZeUtyendZSE9CcnBPNFRkMFdMNmpGRkNPTlQzdHpVVWdmamhPMGUK",
      "endpoints": [
        "https://github.com/kmlpandey77/anvil/releases/latest/download/latest.json"
      ]
    }
  }
}
